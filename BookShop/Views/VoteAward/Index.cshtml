@model IEnumerable<BookShop.Models.VoteAward>

@{
	ViewData["Title"] = "Current Votes";
}

<h1>Be free to vote</h1>

<h1>Index</h1>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Description)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.End)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					<a asp-action="VoteView" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.Title)</a>
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Description)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.End)
				</td>
			</tr>
		}
	</tbody>
</table>